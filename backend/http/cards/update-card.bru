meta {
  name: Update Card
  type: http
  seq: 4
}

put {
  url: {{BASE_URL}}/cards/{{CARD_ID}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Updated Card Title",
    "description": "Updated description"
  }
}
