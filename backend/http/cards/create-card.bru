meta {
  name: Create Card
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/columns/{{COLUMN_ID}}/cards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "My First Card",
    "description": "Card description"
  }
}
