meta {
  name: Update Checklist Item
  type: http
  seq: 2
}

put {
  url: {{BASE_URL}}/checklist-items/{{CHECKLIST_ITEM_ID}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{JWT_TOKEN}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Updated Checklist Item",
    "isCompleted": true
  }
}
