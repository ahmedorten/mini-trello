datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  isDeleted    Boolean   @default(false) @map("is_deleted")
  version      Int       @default(1)

  boards Board[]

  @@map("users")
}

model Board {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  ownerId     String    @map("owner_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy   String?   @map("deleted_by") @db.Uuid
  isDeleted   Boolean   @default(false) @map("is_deleted")
  version     Int       @default(1)

  owner User @relation(fields: [ownerId], references: [id])
  columns Column[]
  labels Label[]

  @@index([ownerId])
  @@map("boards")
}

model Column {
  id        String    @id @default(uuid()) @db.Uuid
  boardId   String    @map("board_id") @db.Uuid
  name      String    @db.VarChar(100)
  position  Int
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")
  version   Int       @default(1)

  board Board   @relation(fields: [boardId], references: [id])
  cards Card[]

  @@index([boardId, isDeleted])
  @@map("columns")
}

model Card {
  id          String      @id @default(uuid()) @db.Uuid
  columnId    String      @map("column_id") @db.Uuid
  title       String      @db.VarChar(255)
  description String?     @db.VarChar(2000)
  position    Int
  dueDate     DateTime?   @map("due_date") @db.Timestamptz
  priority    CardPriority @default(MEDIUM)
  isArchived  Boolean     @default(false) @map("is_archived")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String?     @map("created_by") @db.Uuid
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy   String?     @map("updated_by") @db.Uuid
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz
  deletedBy   String?     @map("deleted_by") @db.Uuid
  isDeleted   Boolean     @default(false) @map("is_deleted")
  version     Int         @default(1)

  column      Column      @relation(fields: [columnId], references: [id])
  cardLabels  CardLabel[]
  comments    Comment[]
  activities  Activity[]
  checklists  Checklist[]
  attachments Attachment[]

  @@index([columnId, isDeleted])
  @@index([columnId, position])
  @@map("cards")
}

model Label {
  id        String      @id @default(uuid()) @db.Uuid
  boardId   String      @map("board_id") @db.Uuid
  name      String      @db.VarChar(50)
  color     String      @db.VarChar(7)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?     @map("created_by") @db.Uuid
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?     @map("updated_by") @db.Uuid
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz
  deletedBy String?     @map("deleted_by") @db.Uuid
  isDeleted Boolean     @default(false) @map("is_deleted")
  version   Int         @default(1)

  board      Board       @relation(fields: [boardId], references: [id])
  cardLabels CardLabel[]

  @@index([boardId, isDeleted])
  @@map("labels")
}

model CardLabel {
  cardId    String   @map("card_id") @db.Uuid
  labelId   String   @map("label_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@map("cards_labels")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  cardId    String    @map("card_id") @db.Uuid
  content   String    @db.VarChar(2000)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")
  version   Int       @default(1)

  card Card @relation(fields: [cardId], references: [id])

  @@index([cardId, isDeleted])
  @@map("comments")
}

enum CardPriority {
  LOW
  MEDIUM
  HIGH
}

model Activity {
  id        String         @id @default(uuid()) @db.Uuid
  cardId    String         @map("card_id") @db.Uuid
  action    ActivityAction
  details   Json?          @db.JsonB
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?        @map("created_by") @db.Uuid

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("activities")
}

enum ActivityAction {
  CARD_CREATED
  CARD_UPDATED
  CARD_DELETED
  CARD_MOVED
  CARD_ARCHIVED
  CARD_UNARCHIVED
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  LABEL_ATTACHED
  LABEL_DETACHED
  CHECKLIST_CREATED
  CHECKLIST_UPDATED
  CHECKLIST_DELETED
  CHECKLIST_ITEM_CREATED
  CHECKLIST_ITEM_COMPLETED
  CHECKLIST_ITEM_UNCOMPLETED
  CHECKLIST_ITEM_DELETED
  ATTACHMENT_ADDED
  ATTACHMENT_UPDATED
  ATTACHMENT_DELETED
}

model Checklist {
  id        String    @id @default(uuid()) @db.Uuid
  cardId    String    @map("card_id") @db.Uuid
  title     String    @db.VarChar(255)
  
  // Audit fields
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?   @map("deleted_by") @db.Uuid
  isDeleted Boolean   @default(false) @map("is_deleted")
  version   Int       @default(1)

  card           Card            @relation(fields: [cardId], references: [id])
  checklistItems ChecklistItem[]

  @@index([cardId, isDeleted])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(uuid()) @db.Uuid
  checklistId String    @map("checklist_id") @db.Uuid
  title       String    @db.VarChar(255)
  isCompleted Boolean   @default(false) @map("is_completed")
  position    Int

  // Audit fields
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy   String?   @map("deleted_by") @db.Uuid
  isDeleted   Boolean   @default(false) @map("is_deleted")
  version     Int       @default(1)

  checklist Checklist @relation(fields: [checklistId], references: [id])

  @@index([checklistId, isDeleted])
  @@index([checklistId, position])
  @@map("checklist_items")
}

model Attachment {
  id         String    @id @default(uuid()) @db.Uuid
  cardId     String    @map("card_id") @db.Uuid
  fileName   String    @map("file_name") @db.VarChar(255)
  storageKey String    @map("storage_key") @db.VarChar(1000)
  fileSize   Int?      @map("file_size")
  mimetype   String?   @db.VarChar(100)
  
  // Audit fields
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy  String?   @map("deleted_by") @db.Uuid
  isDeleted  Boolean   @default(false) @map("is_deleted")
  version    Int       @default(1)

  card Card @relation(fields: [cardId], references: [id])

  @@index([cardId, isDeleted])
  @@map("attachments")
}




